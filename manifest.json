{
  "manifest_version": 3,
  "name": "YouLy+ Apple Music",
  "default_locale": "en",
  "version": "5.0.0",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "*://*.music.apple.com/*",
    "https://api.deepl.com/*",
    "https://api-free.deepl.com/*",
    "https://oneshot-free.www.deepl.com/*",
    "https://translate.googleapis.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/api/*",
    "https://cdn.jsdelivr.net/*",
    "https://github.com/*",
    "https://*.githubusercontent.com/*",
    "https://2755337087.github.io/ttml-hub/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "src/popup/ui.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{00a6e1f0-4808-45e7-b66d-3a5aa6527a0e}",
      "strict_min_version": "122.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.apple.com/*"
      ],
      "js": [
        "src/lib/defaultSettings.js",
        "src/lib/polyfill.js",
        "src/localization.js",
        "src/modules/lyrics/settings.js",
        "src/modules/lyrics/lyricsManager.js",
        "src/modules/applemusic/framePlayer.js",
        "src/modules/applemusic/index.js",
        "src/content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/modules/applemusic/style.css",
        "src/inject/applemusic/songTracker.js",
        "src/player-frame/index.html"
      ],
      "matches": [
        "https://music.apple.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "src/background/lyricsHandler.js",
    "type": "module",
    "scripts": [
      "src/background/lyricsHandler.js"
    ]
  }
}
